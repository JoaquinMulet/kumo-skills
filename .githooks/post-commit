#!/bin/sh
# Hook post-commit: distribuye los archivos de skills tocados por el commit a la
# copia instalada (~/.claude/skills), cerrando MECANICAMENTE el ciclo "dos lugares"
# (CLAUDE.md, seccion "Cuando Claude edite una skill INSTALADA"). Un ritual sin
# enforcement es teatro: la copia repo->instalada ya no depende de la memoria.
#
# Que se distribuye. Todo archivo dentro de la carpeta de una skill, es decir una
# carpeta de la raiz que tiene SKILL.md. Hasta el 4 nov 2026 solo se copiaban
# SKILL.md, reference/ y scripts/, y quedaron atrasadas las plantillas/ de
# documentos-latex, las references/ y los LICENSE de las skills de pstack.
# Lo que NO se distribuye. _deprecated/ (el patron viejo */SKILL.md copio las 8
# skills retiradas a ~/.claude/skills/_deprecated), y los archivos de la raiz.
# Un archivo borrado en el commit se borra tambien de la instalada, pero solo si
# la instalada era igual a la version anterior del repo.
#
# Guardia anti-clobber: si la copia instalada difiere TANTO de la version previa
# del repo COMO de la nueva, tiene ediciones locales no portadas -> avisa por
# stderr y NO la pisa (merge manual). Nunca bloquea: ante fallo, termina 0.

raiz=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$raiz" || exit 0
dest="${KUMO_SKILLS_DESTINO:-$HOME/.claude/skills}"
[ -d "$dest" ] || exit 0
tmp="$raiz/.git/sync-prev.tmp"

git diff-tree --no-commit-id --name-only -r --root HEAD | while IFS= read -r f; do
  case "$f" in
    _deprecated/*) continue ;;
    */*) ;;
    *) continue ;;
  esac
  skill="${f%%/*}"
  # Es una skill si su carpeta tiene SKILL.md ahora, o lo tenia antes del commit.
  if [ ! -f "$skill/SKILL.md" ] && ! git cat-file -e "HEAD~1:$skill/SKILL.md" 2>/dev/null; then
    continue
  fi
  inst="$dest/$f"

  if [ ! -f "$f" ]; then
    # Borrado en el commit. Se borra de la instalada solo si era la version previa.
    [ -f "$inst" ] || continue
    if git show "HEAD~1:$f" > "$tmp" 2>/dev/null && diff -q --strip-trailing-cr "$tmp" "$inst" >/dev/null 2>&1; then
      rm -f "$inst" && echo "[sync] instalada borrada: $f"
    else
      echo "[sync] AVISO: $f se borro del repo pero la instalada tiene cambios propios; NO se borra." >&2
    fi
    rm -f "$tmp"
    continue
  fi

  if [ -f "$inst" ] && ! diff -q --strip-trailing-cr "$f" "$inst" >/dev/null 2>&1; then
    if git show "HEAD~1:$f" > "$tmp" 2>/dev/null; then
      if ! diff -q --strip-trailing-cr "$tmp" "$inst" >/dev/null 2>&1; then
        echo "[sync] AVISO: $inst difiere de la version previa Y de la nueva del repo — posible edicion local no portada; NO se copia (merge manual)." >&2
        rm -f "$tmp"
        continue
      fi
    fi
    rm -f "$tmp"
  fi
  mkdir -p "$(dirname "$inst")"
  cp "$f" "$inst" && echo "[sync] instalada actualizada: $f"
done
exit 0
